#!/bin/bash

# ============================================================
#  OPENBOX TUI INSTALLER — whiptail edition
#  Requires: bash, whiptail, parted, rsync, blkid
# ============================================================

[ "$EUID" -ne 0 ] && echo "[-] Harus dijalankan sebagai root!" && exit 1

command -v whiptail &>/dev/null || {
  echo "[-] whiptail tidak ditemukan. Install dulu: apt install whiptail"
  exit 1
}

# ── Ukuran terminal & dialog dinamis ─────────────────────
TERM_H=$(tput lines  2>/dev/null || echo 24)
TERM_W=$(tput cols   2>/dev/null || echo 80)

# Dialog tidak boleh lebih besar dari terminal
MAX_DH=$(( TERM_H - 2 ))
MAX_DW=$(( TERM_W - 4 ))

# Lebar dialog default (maks 76, min 60)
DW=$(( TERM_W - 8 ))
[ "$DW" -gt 76 ] && DW=76
[ "$DW" -lt 60 ] && DW=60

TITLE="Openbox Installer"

# ── Helper: hitung tinggi dialog agar konten vertikal center ─
# $1 = jumlah baris konten, $2 = overhead (judul+border+tombol = biasanya 6)
dialog_h() {
  local content_lines=$1
  local overhead=${2:-6}
  local dh=$(( content_lines + overhead ))
  [ "$dh" -gt "$MAX_DH" ] && dh=$MAX_DH
  [ "$dh" -lt 7 ]         && dh=7
  echo "$dh"
}

# ── Helper: padding horizontal — center teks dalam lebar DW ──
# Whiptail memiliki ~2 char border kiri+kanan, sisa = DW-4 untuk konten
# Fungsi ini menghasilkan string dengan spasi kiri agar teks di tengah
center_line() {
  local text="$1"
  local inner=$(( DW - 4 ))
  local len=${#text}
  local pad=$(( (inner - len) / 2 ))
  [ "$pad" -lt 0 ] && pad=0
  printf "%${pad}s%s" "" "$text"
}

# ── Helper: baris kosong sejumlah $1 sebagai string \n ───────
vpad() {
  local n=$1
  local s=""
  for (( i=0; i<n; i++ )); do s="${s}\n"; done
  printf "%s" "$s"
}

# ── Helper: error & exit ─────────────────────────────────────
die() {
  local msg="$1"
  local dh; dh=$(dialog_h 3)
  whiptail --title "Error" --msgbox "\n$msg" "$dh" "$DW"
  exit 1
}

# ── Helper: infobox ──────────────────────────────────────────
infobox() {
  local msg="$1"
  local dh; dh=$(dialog_h 3)
  whiptail --title "$TITLE" --infobox "\n$msg" "$dh" "$DW"
}

# ── Helper: buat konten yang dipadding vertikal ───────────────
# Menambah baris kosong di atas/bawah konten agar terasa center
# $1=string konten (sudah mengandung \n), $2=tinggi inner yg diinginkan
vcentered() {
  local body="$1"
  local target_h=${2:-10}
  # Hitung baris body
  local body_lines
  body_lines=$(echo -e "$body" | wc -l)
  local vspace=$(( (target_h - body_lines) / 2 ))
  [ "$vspace" -lt 0 ] && vspace=0
  local pad; pad=$(vpad "$vspace")
  printf "%s%s%s" "$pad" "$body" "$pad"
}

# ============================================================
# SPLASH SCREEN — center vertikal & horizontal
# ============================================================
BANNER_W=42   # lebar teks ascii art

# Hitung padding kiri banner agar center di dalam DW
BANNER_PAD=$(( (DW - 4 - BANNER_W) / 2 ))
[ "$BANNER_PAD" -lt 0 ] && BANNER_PAD=0
BP=$(printf "%${BANNER_PAD}s" "")

# Konten splash
SPLASH_BODY="\
${BP}  ___  ____  _____ _   _ ____   _____  __
${BP} / _ \\|  _ \\| ____| \\ | | __ ) / _ \\ \\/ /
${BP}| | | | |_) |  _| |  \\| |  _ \\| | | \\  /
${BP}| |_| |  __/| |___| |\\  | |_) | |_| /  \\
${BP} \\___/|_|   |_____|_| \\_|____/ \\___/_/\\_\\
\n\
$(center_line "Openbox Setup Installer — TUI Edition")\n\
$(center_line "======================================")\n\
\n\
$(center_line "Installer ini akan memandu kamu menyalin")\n\
$(center_line "sistem ke disk target dan mengatur GRUB.")\n\
\n\
$(center_line "Pastikan disk target sudah terpasang")\n\
$(center_line "sebelum melanjutkan.")"

SPLASH_LINES=13
SPLASH_H=$(dialog_h $SPLASH_LINES 7)

whiptail --title "$TITLE" \
  --msgbox "$(vcentered "$SPLASH_BODY" $(( SPLASH_H - 7 )))" \
  "$SPLASH_H" "$DW"

# ============================================================
# [1] DETEKSI UEFI / BIOS
# ============================================================
IS_UEFI=0
[ -d "/sys/firmware/efi" ] && IS_UEFI=1

if [ "$IS_UEFI" -eq 1 ]; then
  BOOT_MODE="UEFI (GPT)"
else
  BOOT_MODE="BIOS Legacy (MBR)"
fi

BOOT_BODY="\
$(center_line "Mode boot terdeteksi:")\n\
\n\
$(center_line "[ $BOOT_MODE ]")\n\
\n\
$(center_line "Pastikan GRUB yang akan dipasang")\n\
$(center_line "sesuai dengan mode ini.")"

BH=$(dialog_h 8 6)
whiptail --title "$TITLE" \
  --msgbox "$(vcentered "$BOOT_BODY" $(( BH - 6 )))" \
  "$BH" "$DW"

# ============================================================
# [2] TIMEZONE
# ============================================================
TZ_H=$(dialog_h 5 8)
TIMEZONE=$(whiptail --title "$TITLE" \
  --inputbox "\n$(center_line "Masukkan timezone sistem:")\n$(center_line "(contoh: Asia/Jakarta, Asia/Makassar, UTC)")\n" \
  "$TZ_H" "$DW" "Asia/Jakarta" \
  3>&1 1>&2 2>&3) || exit 0

[ -z "$TIMEZONE" ] && TIMEZONE="Asia/Jakarta"

if [ ! -f "/usr/share/zoneinfo/$TIMEZONE" ]; then
  TZW_H=$(dialog_h 4 6)
  whiptail --title "Peringatan" \
    --yesno "\n$(center_line "Timezone '$TIMEZONE' tidak ditemukan.")\n$(center_line "Lanjutkan tetap dengan nilai ini?")\n" \
    "$TZW_H" "$DW" || exit 0
fi

# ============================================================
# [3] USERNAME
# ============================================================
while true; do
  UN_H=$(dialog_h 3 8)
  NEW_USER=$(whiptail --title "$TITLE" \
    --inputbox "\n$(center_line "Masukkan nama pengguna baru:")\n" \
    "$UN_H" "$DW" "" \
    3>&1 1>&2 2>&3) || exit 0

  if [ -z "$NEW_USER" ]; then
    EH=$(dialog_h 2 6); whiptail --title "Error" --msgbox "\n$(center_line "Username tidak boleh kosong!")\n" "$EH" "$DW"
    continue
  fi

  if ! echo "$NEW_USER" | grep -qE '^[a-z][a-z0-9_.-]{0,30}$'; then
    EH=$(dialog_h 5 6)
    whiptail --title "Error" \
      --msgbox "\n$(center_line "Username tidak valid.")\n\n$(center_line "Gunakan huruf kecil, angka, titik, atau strip.")\n$(center_line "Maks 31 karakter, diawali huruf kecil.")\n" \
      "$EH" "$DW"
    continue
  fi

  break
done

# ============================================================
# [4] PASSWORD
# ============================================================
while true; do
  PH=$(dialog_h 3 8)
  NEW_PASS=$(whiptail --title "$TITLE" \
    --passwordbox "\n$(center_line "Masukkan password untuk '$NEW_USER':")\n" \
    "$PH" "$DW" \
    3>&1 1>&2 2>&3) || exit 0

  NEW_PASS_CONFIRM=$(whiptail --title "$TITLE" \
    --passwordbox "\n$(center_line "Konfirmasi password:")\n" \
    "$PH" "$DW" \
    3>&1 1>&2 2>&3) || exit 0

  if [ -z "$NEW_PASS" ]; then
    EH=$(dialog_h 2 6); whiptail --title "Error" --msgbox "\n$(center_line "Password tidak boleh kosong!")\n" "$EH" "$DW"
    continue
  fi

  if [ "$NEW_PASS" != "$NEW_PASS_CONFIRM" ]; then
    EH=$(dialog_h 2 6); whiptail --title "Error" --msgbox "\n$(center_line "Password tidak cocok, coba lagi!")\n" "$EH" "$DW"
    continue
  fi

  if [ ${#NEW_PASS} -lt 6 ]; then
    WH=$(dialog_h 3 6)
    whiptail --title "Peringatan" \
      --yesno "\n$(center_line "Password sangat pendek (< 6 karakter).")\n$(center_line "Tetap gunakan password ini?")\n" \
      "$WH" "$DW" || continue
  fi

  break
done

# ============================================================
# [5] AUTOLOGIN
# ============================================================
AH=$(dialog_h 3 6)
AUTO_LOGIN="n"
if whiptail --title "$TITLE" \
   --yesno "\n$(center_line "Aktifkan autologin untuk '$NEW_USER' ke TTY1?")\n" \
   "$AH" "$DW"; then
  AUTO_LOGIN="y"
fi

# ============================================================
# [6] PILIH DISK TARGET
# ============================================================
DISK_LIST=()
while IFS= read -r line; do
  NAME=$(echo "$line" | awk '{print $1}')
  SIZE=$(echo "$line" | awk '{print $2}')
  MODEL=$(echo "$line" | awk '{$1=$2=""; print $0}' | xargs)
  [ -z "$MODEL" ] && MODEL="(no model)"
  DISK_LIST+=("/dev/$NAME" "$SIZE  $MODEL")
done < <(lsblk -d -o NAME,SIZE,MODEL --noheadings | grep -v "^loop")

[ ${#DISK_LIST[@]} -eq 0 ] && die "Tidak ada disk yang terdeteksi!"

NDISK=$(( ${#DISK_LIST[@]} / 2 ))
MENU_INNER=$(( NDISK > 6 ? 6 : NDISK ))
MENU_H=$(dialog_h $(( MENU_INNER + 5 )) 6)

TARGET=$(whiptail --title "$TITLE" \
  --menu "\n$(center_line "Pilih disk target instalasi:")\n$(center_line "!! SEMUA DATA DI DISK TERPILIH AKAN DIHAPUS !!")\n" \
  "$MENU_H" "$DW" "$MENU_INNER" \
  "${DISK_LIST[@]}" \
  3>&1 1>&2 2>&3) || exit 0

[ ! -b "$TARGET" ] && die "Disk $TARGET tidak ditemukan atau tidak valid."
TARGET_DISK=$(basename "$TARGET")

# ============================================================
# [7] RINGKASAN & KONFIRMASI AKHIR
# ============================================================
DISK_INFO=$(lsblk -d -o SIZE,MODEL "$TARGET" --noheadings | head -1 | xargs)

# Lebar kolom label dan nilai
LBL="  %-12s: %s"

SUM_BODY="\
$(center_line "Konfigurasi yang akan diterapkan")\n\
$(center_line "=================================")\n\
\n\
$(printf "$LBL" "Mode Boot"  "$BOOT_MODE")\n\
$(printf "$LBL" "Timezone"   "$TIMEZONE")\n\
$(printf "$LBL" "Username"   "$NEW_USER")\n\
$(printf "$LBL" "Autologin"  "$AUTO_LOGIN")\n\
$(printf "$LBL" "Disk"       "$TARGET")\n\
$(printf "$LBL" "Disk Info"  "$DISK_INFO")\n\
\n\
$(center_line "Tekan OK untuk ke konfirmasi akhir.")"

SH=$(dialog_h 12 6)
whiptail --title "Ringkasan Instalasi" \
  --msgbox "$(vcentered "$SUM_BODY" $(( SH - 6 )))" \
  "$SH" "$DW"

# -- Konfirmasi destruktif --
WARN_BODY="\
$(center_line "!! PERINGATAN: OPERASI DESTRUKTIF !!")\n\
\n\
$(center_line "Disk berikut akan dihapus PERMANEN:")\n\
\n\
$(center_line "$TARGET  ($DISK_INFO)")\n\
\n\
$(center_line "Tindakan ini TIDAK DAPAT DIBATALKAN")\n\
$(center_line "setelah proses dimulai.")\n\
\n\
$(center_line "Apakah kamu yakin ingin melanjutkan?")"

WBH=$(dialog_h 11 6)
whiptail --title "!!! KONFIRMASI AKHIR !!!" \
  --yesno "$(vcentered "$WARN_BODY" $(( WBH - 6 )))" \
  "$WBH" "$DW" \
  || { DH=$(dialog_h 2 6)
       whiptail --title "$TITLE" --msgbox "\n$(center_line "Instalasi dibatalkan.")\n" "$DH" "$DW"
       exit 0; }



# ============================================================
# [8] NAMA PARTISI
# ============================================================
if [[ "$TARGET_DISK" =~ nvme|mmcblk ]]; then
  EFI_PART="${TARGET}p1"
  ROOT_PART="${TARGET}p2"
  BIOS_ROOT_PART="${TARGET}p1"
else
  EFI_PART="${TARGET}1"
  ROOT_PART="${TARGET}2"
  BIOS_ROOT_PART="${TARGET}1"
fi

GW="$DW"
GH=$(dialog_h 1 6)

# ============================================================
# [9] EKSEKUSI
# ============================================================

# ── Tahap 1: Partisi ─────────────────────────────────────
{
  wipefs -a "$TARGET" &>/dev/null; echo 20
  if [ "$IS_UEFI" -eq 1 ]; then
    parted -s "$TARGET" mklabel gpt            &>/dev/null; echo 40
    parted -s "$TARGET" mkpart ESP fat32 1MiB 513MiB &>/dev/null; echo 65
    parted -s "$TARGET" set 1 esp on           &>/dev/null; echo 80
    parted -s "$TARGET" mkpart primary ext4 513MiB 100% &>/dev/null
  else
    parted -s "$TARGET" mklabel msdos          &>/dev/null; echo 50
    parted -s "$TARGET" mkpart primary ext4 1MiB 100% &>/dev/null; echo 80
    parted -s "$TARGET" set 1 boot on          &>/dev/null
  fi
  echo 100
} | whiptail --title "$TITLE" --gauge \
    "$(center_line "[1/6] Membuat tabel partisi...")" \
    "$GH" "$GW" 0

# ── Tahap 2: Format ───────────────────────────────────────
{
  echo 10
  if [ "$IS_UEFI" -eq 1 ]; then
    mkfs.vfat -F32 "$EFI_PART"    &>/dev/null; echo 50
    mkfs.ext4 -F   "$ROOT_PART"   &>/dev/null
  else
    mkfs.ext4 -F   "$BIOS_ROOT_PART" &>/dev/null
  fi
  echo 100
} | whiptail --title "$TITLE" --gauge \
    "$(center_line "[2/6] Memformat partisi...")" \
    "$GH" "$GW" 0

if [ "$IS_UEFI" -eq 1 ]; then TARGET_ROOT_PART="$ROOT_PART"
else TARGET_ROOT_PART="$BIOS_ROOT_PART"; fi

# ── Tahap 3: Mount ────────────────────────────────────────
infobox "$(center_line "[3/6] Mounting partisi ke /mnt...")"
mkdir -p /mnt
mount "$TARGET_ROOT_PART" /mnt  || die "Gagal mount $TARGET_ROOT_PART ke /mnt"
if [ "$IS_UEFI" -eq 1 ]; then
  mkdir -p /mnt/boot/efi
  mount "$EFI_PART" /mnt/boot/efi || die "Gagal mount EFI partition"
fi

# ── Tahap 4: Hitung + salin filesystem ───────────────────
infobox "$(center_line "[4/6] Menghitung file yang akan disalin...")"

# Array exclude — brace expansion TIDAK bekerja dalam variabel string biasa,
# harus pakai array agar setiap --exclude di-pass sebagai argumen terpisah
RSYNC_EXCL=(
  --exclude='/dev/*'
  --exclude='/proc/*'
  --exclude='/sys/*'
  --exclude='/tmp/*'
  --exclude='/run/*'
  --exclude='/mnt/*'
  --exclude='/media/*'
  --exclude='/lost+found'
)

TOTAL_FILES=$(rsync -aAXn "${RSYNC_EXCL[@]}" / /mnt 2>/dev/null | wc -l)
[ "$TOTAL_FILES" -eq 0 ] && TOTAL_FILES=1

# Jalankan rsync ke file sementara agar exit code bisa dicek di luar subshell
RSYNC_LOG=$(mktemp)
(
  COPIED=0
  rsync -aAX "${RSYNC_EXCL[@]}" --info=name / /mnt 2>"$RSYNC_LOG" | \
  while IFS= read -r _; do
    ((COPIED++))
    PCT=$(( COPIED * 100 / TOTAL_FILES ))
    [ "$PCT" -gt 99 ] && PCT=99
    echo "$PCT"
  done
  echo 100
) | whiptail --title "$TITLE" --gauge \
    "$(center_line "[4/6] Menyalin root filesystem (~$TOTAL_FILES item)...")" \
    "$GH" "$GW" 0

# Verifikasi: /mnt/bin/bash harus ada sebelum lanjut ke chroot
BASH_PATH=""
if   [ -f "/mnt/bin/bash" ];     then BASH_PATH="/mnt/bin/bash"
elif [ -f "/mnt/usr/bin/bash" ]; then BASH_PATH="/mnt/usr/bin/bash"
fi

if [ -z "$BASH_PATH" ]; then
  RSYNC_ERR=$(cat "$RSYNC_LOG" 2>/dev/null | head -10 | sed 's/[^[:print:]\t]//g')
  rm -f "$RSYNC_LOG"
  EH=$(( MAX_DH > 18 ? 18 : MAX_DH ))
  whiptail --title "Rsync Gagal" --scrolltext \
    --msgbox "Filesystem tidak tersalin dengan benar.\n/mnt/bin/bash tidak ditemukan.\n\nKemungkinan penyebab:\n- Rsync error di tengah proses\n- Disk target terlalu kecil\n- Partisi tidak ter-mount dengan benar\n\nError rsync:\n$RSYNC_ERR\n\nInstalasi dibatalkan." \
    "$EH" "$DW"
  # Unmount sebelum keluar
  umount /mnt/boot/efi 2>/dev/null
  umount /mnt 2>/dev/null
  exit 1
fi
rm -f "$RSYNC_LOG"

# ── Tahap 5: fstab & identitas ────────────────────────────
{
  echo 10; mkdir -p /mnt/{dev,proc,sys,tmp,run}; echo 30
  ROOT_UUID=$(blkid -s UUID -o value "$TARGET_ROOT_PART")
  echo "UUID=$ROOT_UUID / ext4 errors=remount-ro 0 1" > /mnt/etc/fstab; echo 60
  if [ "$IS_UEFI" -eq 1 ]; then
    EFI_UUID=$(blkid -s UUID -o value "$EFI_PART")
    echo "UUID=$EFI_UUID /boot/efi vfat defaults 0 2" >> /mnt/etc/fstab
  fi
  echo 80; truncate -s 0 /mnt/etc/machine-id
  rm -f /mnt/var/lib/dbus/machine-id; echo 100
} | whiptail --title "$TITLE" --gauge \
    "$(center_line "[5/6] Menulis fstab & mereset identitas sistem...")" \
    "$GH" "$GW" 0

# ── Tahap 6: Chroot ───────────────────────────────────────
infobox "$(center_line "[6/6] Chroot: user, initramfs & GRUB (beberapa menit)...")"

mount --bind /dev     /mnt/dev
mount --bind /dev/pts /mnt/dev/pts
mount --bind /proc    /mnt/proc
mount --bind /sys     /mnt/sys
mount --bind /run     /mnt/run

CHROOT_LOG=$(mktemp)

chroot /mnt /bin/bash <<EOF 2>&1 | tee "$CHROOT_LOG"
export DEBIAN_FRONTEND=noninteractive

echo "[chroot] Mengatur timezone..."
ln -sf /usr/share/zoneinfo/$TIMEZONE /etc/localtime
dpkg-reconfigure -f noninteractive tzdata

echo "[chroot] Membuat user $NEW_USER..."
id -u "$NEW_USER" &>/dev/null || \
  useradd -m -s /bin/bash -G sudo,adm,cdrom,plugdev,netdev "$NEW_USER"
echo "$NEW_USER:$NEW_PASS" | chpasswd

mkdir -p /etc/sudoers.d
echo "$NEW_USER ALL=(ALL:ALL) NOPASSWD:ALL" > /etc/sudoers.d/$NEW_USER
chmod 0440 /etc/sudoers.d/$NEW_USER

if [ "$AUTO_LOGIN" = "y" ]; then
  echo "[chroot] Mengatur autologin..."
  mkdir -p /etc/systemd/system/getty@tty1.service.d
  cat > /etc/systemd/system/getty@tty1.service.d/autologin.conf <<EOT
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin $NEW_USER --noclear %I \$TERM
EOT
fi

echo "[chroot] Memperbarui initramfs..."
update-initramfs -u -k all

echo "[chroot] Memasang GRUB..."
if [ -d "/sys/firmware/efi" ]; then
  apt-get update -y
  apt-get install -y grub-efi-amd64
  grub-install --target=x86_64-efi \
    --efi-directory=/boot/efi \
    --bootloader-id=GRUB --recheck
else
  apt-get update -y
  apt-get install -y grub-pc
  grub-install "$TARGET"
fi

echo "[chroot] Memperbarui konfigurasi GRUB..."
update-grub
EOF

CHROOT_EXIT=${PIPESTATUS[0]}

# ── Cleanup ───────────────────────────────────────────────
{
  echo 10; sync; echo 30
  [ "$IS_UEFI" -eq 1 ] && umount /mnt/boot/efi 2>/dev/null
  echo 50
  umount /mnt/dev/pts /mnt/dev 2>/dev/null; echo 70
  umount /mnt/proc /mnt/sys /mnt/run 2>/dev/null; echo 90
  umount /mnt 2>/dev/null; echo 100
} | whiptail --title "$TITLE" --gauge \
    "$(center_line "Membersihkan & unmounting partisi...")" \
    "$GH" "$GW" 0

# ============================================================
# [10] HASIL AKHIR
# ============================================================
if [ "$CHROOT_EXIT" -ne 0 ]; then
  LOG_SNIPPET=$(tail -20 "$CHROOT_LOG" 2>/dev/null \
    | sed 's/[^[:print:]\t]//g')
  FH=$(( MAX_DH > 22 ? 22 : MAX_DH ))
  whiptail --title "Instalasi Gagal" --scrolltext \
    --msgbox "Proses chroot error (kode: $CHROOT_EXIT).\n\nLog:\n\n$LOG_SNIPPET\n\nLog lengkap: $CHROOT_LOG" \
    "$FH" "$DW"
  exit 1
fi

rm -f "$CHROOT_LOG"

DONE_BODY="\
$(center_line "Instalasi berhasil diselesaikan!")\n\
$(center_line "================================")\n\
\n\
$(printf "  %-10s : %s" "Disk"     "$TARGET")\n\
$(printf "  %-10s : %s" "User"     "$NEW_USER")\n\
$(printf "  %-10s : %s" "Boot"     "$BOOT_MODE")\n\
$(printf "  %-10s : %s" "Timezone" "$TIMEZONE")\n\
\n\
$(center_line "Jangan lupa cabut media instalasi")\n\
$(center_line "sebelum menyalakan ulang sistem.")"

DH=$(dialog_h 12 7)
whiptail --title "Instalasi Selesai" \
  --msgbox "$(vcentered "$DONE_BODY" $(( DH - 7 )))" \
  "$DH" "$DW"

# ── Opsi tindakan setelah instalasi ──────────────────────
ACTION=$(whiptail --title "Selesai — Apa yang ingin kamu lakukan?" \
  --menu "\n$(center_line "Pilih tindakan selanjutnya:")\n" \
  $(dialog_h 5 8) "$DW" 3 \
  "reboot"   "Restart sistem sekarang" \
  "poweroff" "Matikan sistem sekarang" \
  "exit"     "Keluar ke terminal (tanpa restart)" \
  3>&1 1>&2 2>&3)

case "$ACTION" in
  reboot)
    whiptail --title "$TITLE" \
      --infobox "\n$(center_line "Sistem akan direstart, sampai jumpa!")\n" \
      $(dialog_h 1 6) "$DW"
    sleep 2
    reboot
    ;;
  poweroff)
    whiptail --title "$TITLE" \
      --infobox "\n$(center_line "Sistem akan dimatikan, sampai jumpa!")\n" \
      $(dialog_h 1 6) "$DW"
    sleep 2
    poweroff
    ;;
  *)
    clear
    echo ""
    echo "  Instalasi selesai. Kamu bisa reboot manual dengan:"
    echo "    reboot   — untuk restart"
    echo "    poweroff — untuk mematikan"
    echo ""
    ;;
esac

exit 0
