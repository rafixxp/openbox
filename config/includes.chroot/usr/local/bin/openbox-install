#!/bin/bash

# Pastikan dijalankan sebagai root
if [ "$EUID" -ne 0 ]; then
  echo "[-] Error: Script ini harus dijalankan sebagai root!"
  exit 1
fi

clear

# Banner ASCII Openbox (Biar estetik ala distro custom)
echo -e "\033[0;36m"
cat << "EOF"
  ██████╗ ██████╗ ███████╗███╗   ██╗██████╗  ██████╗ ██╗  ██╗
 ██╔═══██╗██╔══██╗██╔════╝████╗  ██║██╔══██╗██╔═══██╗╚██╗██╔╝
 ██║   ██║██████╔╝█████╗  ██╔██╗ ██║██████╔╝██║   ██║ ╚███╔╝ 
 ██║   ██║██╔═══╝ ██╔══╝  ██║╚██╗██║██╔══██╗██║   ██║ ██╔██╗ 
 ╚██████╔╝██║     ███████╗██║ ╚████║██████╔╝╚██████╔╝██╔╝ ██╗
  ╚═════╝ ╚═╝     ╚══════╝╚═╝  ╚═══╝╚═════╝  ╚═════╝ ╚═╝  ╚═╝
EOF
echo -e "\033[0m"
echo "==============================================================="
echo "Openbox Setup Installer							             "
echo "==============================================================="
echo ""

# 1. Konfigurasi User & Timezone Terlebih Dahulu
echo "[*] Konfigurasi Awal Sistem:"
read -p "Masukkan Timezone (contoh: Asia/Jakarta) [Default: Asia/Jakarta]: " TIMEZONE
TIMEZONE=${TIMEZONE:-Asia/Jakarta}

read -p "Masukkan Username baru untuk login: " NEW_USER
if [ -z "$NEW_USER" ]; then
  echo "[-] Error: Username tidak boleh kosong!"
  exit 1
fi

read -s -p "Masukkan Password untuk $NEW_USER: " NEW_PASS
echo ""
read -s -p "Konfirmasi Password: " NEW_PASS_CONFIRM
echo ""

if [ "$NEW_PASS" != "$NEW_PASS_CONFIRM" ]; then
  echo "[-] Error: Password tidak cocok!"
  exit 1
fi

read -p "Aktifkan autologin otomatis untuk user $NEW_USER? (y/n): " AUTO_LOGIN

echo ""
# 2. Deteksi Disk yang Tersedia
echo "[*] Daftar Disk yang Tersedia di Sistem:"
lsblk -d -o NAME,SIZE,MODEL
echo ""

read -p "Masukkan nama disk target (contoh: sda / vda): " TARGET_DISK
TARGET="/dev/$TARGET_DISK"

# Validasi disk
if [ ! -b "$TARGET" ]; then
  echo "[-] Error: Disk $TARGET tidak ditemukan!"
  exit 1
fi

echo ""
echo "[!] PERINGATAN KERAS: Semua data di $TARGET akan DIHAPUS TOTAL!"
read -p "Apakah kamu yakin ingin melanjutkan? (y/n): " CONFIRM
if [ "$CONFIRM" != "y" ]; then
  echo "Instalasi dibatalkan."
  exit 0
fi

echo ""
echo "[*] [1/6] Mempersiapkan tabel partisi pada $TARGET..."
wipefs -a "$TARGET"
parted -s "$TARGET" mklabel msdos
parted -s "$TARGET" mkpart primary ext4 1MiB 100%
parted -s "$TARGET" set 1 boot on

# Handle penamaan partisi NVMe/VirtIO/SATA
PARTITION="${TARGET}1"
if [[ "$TARGET_DISK" =~ "nvme" ]] || [[ "$TARGET_DISK" =~ "mmcblk" ]]; then
  PARTITION="${TARGET}p1"
fi

echo "[*] [2/6] Memformat partisi $PARTITION ke sistem file ext4..."
mkfs.ext4 -F "$PARTITION"

echo "[*] [3/6] Mounting partisi target ke /mnt..."
mkdir -p /mnt
mount "$PARTITION" /mnt

echo "[*] [4/6] Menyalin seluruh Root Filesystem ke disk target..."
rsync -aAXv / /mnt --exclude={"/dev/*","/proc/*","/sys/*","/tmp/*","/run/*","/mnt/*","/media/*","/lost+found"}

echo "[*] [5/6] Menyiapkan direktori virtual dan /etc/fstab..."
mkdir -p /mnt/dev /mnt/proc /mnt/sys /mnt/tmp /mnt/run

# Generate fstab otomatis berdasarkan UUID partisi baru
UUID=$(blkid -s UUID -o value "$PARTITION")
echo "UUID=$UUID / ext4 errors=remount-ro 0 1" > /mnt/etc/fstab

echo "[*] [6/6] Melakukan Chroot untuk konfigurasi sistem, initramfs, dan GRUB..."
mount --bind /dev /mnt/dev
mount --bind /proc /mnt/proc
mount --bind /sys /mnt/sys

chroot /mnt /bin/bash <<EOF
# Set Timezone
ln -sf /usr/share/zoneinfo/$TIMEZONE /etc/localtime
dpkg-reconfigure -f noninteractive tzdata

# Buat User Baru & Tambahkan ke Grup Sudo
useradd -m -s /bin/bash -G sudo,adm,cdrom,plugdev,netdev "$NEW_USER"
echo "$NEW_USER:$NEW_PASS" | chpasswd

# Konfigurasi Sudoers tanpa password
mkdir -p /etc/sudoers.d
echo "$NEW_USER ALL=(ALL:ALL) NOPASSWD:ALL" > /etc/sudoers.d/$NEW_USER
chmod 0440 /etc/sudoers.d/$NEW_USER

# Konfigurasi Autologin jika dipilih 'y'
if [ "$AUTO_LOGIN" = "y" ]; then
    mkdir -p /etc/systemd/system/getty@tty1.service.d
    cat <<EOT > /etc/systemd/system/getty@tty1.service.d/autologin.conf
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin "$NEW_USER" --noclear %I \$TERM
EOT
fi

update-initramfs -u -k all
grub-install "$TARGET"
update-grub
EOF

echo "[*] Membersihkan mount point..."
umount /mnt/dev /mnt/proc /mnt/sys
umount /mnt

echo ""
echo "[*] YEAY !, Instalasi ke disk berhasil !. Silakan reboot VM !"
