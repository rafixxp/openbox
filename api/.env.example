NODE_ENV=development
HOST=0.0.0.0
PORT=8090
LOG_LEVEL=info

# Shared service-to-service secret. Must match panel .env BUILD_AGENT_SECRET.
BUILD_AGENT_SECRET=dev-agent-secret-change-me
HMAC_CLOCK_SKEW_SECONDS=300

# --- Queue ------------------------------------------------------------------
REDIS_URL=redis://redis:6379
BUILD_QUEUE=builds
BUILD_CONCURRENCY=1

# --- live-build -------------------------------------------------------------
BUILD_SCRIPT=/opt/openbox/docker/scripts/build-iso.sh
BUILD_SOURCE_ROOT=/workspace/source
BUILD_WORK_DIR=/var/lib/openbox-build
BUILD_ISO_NAME=openbox-image-amd64.hybrid.iso
BUILD_TIMEOUT_SECONDS=7200
PANEL_INSTALLER_PATH=/workspace/source/install_panel_en.sh

# --- Callbacks --------------------------------------------------------------
CALLBACK_TIMEOUT_MS=10000
CALLBACK_MAX_ATTEMPTS=3
LOG_BATCH_SIZE=25
LOG_BATCH_INTERVAL_MS=1500
STATUS_THROTTLE_MS=2500

# --- Artifacts --------------------------------------------------------------
ARTIFACT_DISK=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=openbox-artifacts
S3_ACCESS_KEY_ID=openbox
S3_SECRET_ACCESS_KEY=openbox-minio-password
S3_FORCE_PATH_STYLE=true

# The HTTP container sets this to false; the worker entrypoint ignores it.
WORKER_ENABLED=true
