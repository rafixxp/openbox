{
    "name": "@openbox/build-agent",
    "version": "1.0.0",
    "private": true,
    "description": "Fastify build agent that runs live-build inside an isolated, privileged worker.",
    "license": "MIT",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "worker": "tsx src/worker-entry.ts",
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/index.js",
        "start:worker": "node dist/worker-entry.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.700.0",
        "bullmq": "^5.34.0",
        "fastify": "^5.2.0",
        "ioredis": "^5.4.2",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2",
        "vitest": "^2.1.8"
    },
    "engines": {
        "node": ">=20"
    }
}
