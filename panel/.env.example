APP_NAME="Openbox Panel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=openbox_panel
DB_USERNAME=openbox
DB_PASSWORD=openbox-dev-password
DB_SSLMODE=prefer

# --- Redis / queues ---------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=900
HORIZON_PREFIX=openbox_horizon:

# --- Reverb / broadcasting --------------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=openbox
REVERB_APP_KEY=openbox-key
REVERB_APP_SECRET=openbox-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY=openbox-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME=http

# --- Sanctum ----------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080

# --- Artifacts (MinIO / S3) -------------------------------------------------
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=openbox
AWS_SECRET_ACCESS_KEY=openbox-minio-password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=openbox-artifacts
AWS_ENDPOINT=http://minio:9000
# Optional browser-reachable endpoint for signed download URLs. In Compose the
# panel talks to minio:9000, while the host browser reaches localhost:9000.
# Leave empty in production when AWS_ENDPOINT is already public.
AWS_PUBLIC_ENDPOINT=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Build pipeline ---------------------------------------------------------
BUILD_DRIVER=agent
BUILD_AGENT_URL=http://build-agent:8090
BUILD_AGENT_SECRET=dev-agent-secret-change-me
BUILD_AGENT_CALLBACK_URL=http://nginx
BUILD_AGENT_TIMEOUT=15
BUILD_QUEUE=builds
BUILD_TIMEOUT=7200
BUILD_ISO_NAME=openbox-image-amd64.hybrid.iso
BUILD_ISOLATED_WORKSPACE=true
OPENBOX_ROOT=/workspace/source
BUILD_WORK_DIR=/var/lib/openbox-build/workspace
PANEL_INSTALLER_PATH=/workspace/source/install_panel_en.sh

# --- Signing / mirrors ------------------------------------------------------
GNUPGHOME=/var/www/html/storage/app/gnupg
GPG_KEY_ID=
GPG_PASSPHRASE=
MIRROR_SYNCER=rclone
RCLONE_BINARY=rclone
MIRROR_SOURCE=
MIRROR_SYNC_TIMEOUT=3600

# --- Mail / notifications ---------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS=panel@openbox.local
MAIL_FROM_NAME="Openbox Panel"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Bootstrap admin (database seeder) --------------------------------------
PANEL_ADMIN_EMAIL=admin@example.com
PANEL_ADMIN_PASSWORD=Openbox-Dev-Admin-2026!
